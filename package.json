{
  "name": "@company/mui-dynamic-table",
  "version": "0.1.0",
  "description": "Reusable MUI and TanStack Table for Next.js JavaScript apps",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {".": {"import": "./dist/index.js"}},
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.js --format esm --clean --external react,react-dom,@mui/material,@mui/icons-material,@emotion/react,@emotion/styled,@tanstack/react-table",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "@mui/material": "^5.15.0 || ^6.0.0 || ^7.0.0",
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@tanstack/react-table": "^8.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.0.0",
    "@tanstack/react-table": "^8.20.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
